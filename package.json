{
  "name": "eldrift-rewrite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node tools/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run test/smoke",
    "check:bundle": "npm run build && node tools/check-bundle.mjs",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "trace": "node tools/trace.mjs",
    "upload": "node tools/upload.mjs",
    "check:lizard": "node tools/quality.mjs",
    "quality": "npm run typecheck && npm run check:boundaries && npm run check:lizard"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@types/screeps": "3.4.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "typescript-ast": "npm:typescript@6.0.3",
    "vitest": "5.1.0"
  }
}
