{
  "name": "eldrift-rewrite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node tools/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run test/smoke",
    "check:bundle": "npm run build && node tools/check-bundle.mjs",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "trace": "node tools/trace.mjs",
    "upload": "node tools/upload.mjs",
    "check:lizard": "node tools/quality.mjs",
    "quality": "npm run typecheck && npm run lint && npm run check:boundaries && npm run check:lizard",
    "lint": "eslint src test --max-warnings 0",
    "test:engine": "npm run build && node tools/engine/smoke.cjs",
    "test:engine:suite": "node --test tools/engine/suite-report-check.cjs && npm run build && node tools/engine/suite.cjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jridgewell/trace-mapping": "0.3.31",
    "@types/screeps": "3.4.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
